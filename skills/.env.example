# QMT Trading Skill — 客户端连接配置（社区 / Agent 安装）
# 将本文件复制为与 _shared 同级的 .env：
#   copy .env.example .env
# 路径示例：~/.agents/skills/.env 、 ~/.workbuddy/skills/.env 、 .cursor/skills/.env
#
# 服务端监听 / miniQMT 请在 qmt-bridge 仓库配置，勿与此处混淆。

# 客户端目标（不要写成 0.0.0.0）
QMT_BRIDGE_HOST=127.0.0.1
QMT_BRIDGE_PORT=8080

# 须与 Bridge 侧 QMT_BRIDGE_API_KEY 一致（勿提交真实密钥）
# QMT_BRIDGE_API_KEY=your-secret-api-key

# QMT_BRIDGE_STOCK_ACCOUNT_ID=
# QMT_BRIDGE_CREDIT_ACCOUNT_ID=
# QMT_BRIDGE_DEFAULT_ACCOUNT=stock
