# QMT Trading Skill — 连接已启动的 QMT Bridge
# 复制此文件为 .env:  cp .env.example .env
# 服务端监听 / miniQMT 路径请在 qmt-bridge 仓库配置

# 客户端目标（不要写成 0.0.0.0）
QMT_BRIDGE_HOST=127.0.0.1
QMT_BRIDGE_PORT=8080

# 须与 Bridge 侧 QMT_BRIDGE_API_KEY 一致
# QMT_BRIDGE_API_KEY=your-secret-api-key

# QMT_BRIDGE_STOCK_ACCOUNT_ID=
# QMT_BRIDGE_CREDIT_ACCOUNT_ID=
# QMT_BRIDGE_DEFAULT_ACCOUNT=stock

# 每日复盘定时调度（scripts\daily_eval_scheduler.py）
# DAILY_EVAL_SCHEDULE_TIME=15:10
# DAILY_EVAL_SCHEDULE_INTERVAL_SEC=30
# DAILY_EVAL_SCHEDULE_COMBINED=true
# FEISHU_DAILY_EVAL_WIKI_PARENT_TOKEN=
# LARK_CLI_AS=user

# 飞书云文档（skills/qmt-bridge-feishu-doc）
# FEISHU_QMT_BRIDGE_FOLDER_TOKEN=
# FEISHU_FOLDER_DAILY_EVAL_TOKEN=
# FEISHU_DAILY_EVAL_DOC_ID=
